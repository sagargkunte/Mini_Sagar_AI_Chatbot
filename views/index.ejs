<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f0f2f5;
        margin: 0;
        padding: 20px;
      }

      #messages {
        max-width: 600px;
        margin: 0 auto 20px auto;
        background-color: #ffffff;
        padding: 10px;
        border-radius: 8px;
        height: 400px;
        overflow-y: auto;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }

      #messages p {
        max-width: 70%;
        margin: 8px 0;
        padding: 10px 15px;
        border-radius: 20px;
        line-height: 1.4;
        display: inline-block;
        clear: both;
      }

      /* User message - Left */
      #messages .user {
        background-color: #e1ffc7;
        float: left;
        text-align: left;
      }

      /* AI message - Right */
      #messages .ai {
        background-color: #dcf8c6;
        float: right;
        text-align: right;
      }

      #msg {
        width: 75%;
        padding: 10px;
        margin-right: 10px;
        border-radius: 20px;
        border: 1px solid #ccc;
        position: fixed;
        bottom: 2rem;
      }

      #sendBtn {
        padding: 10px 20px;
        border: none;
        border-radius: 20px;
        background-color: #4caf50;
        color: white;
        cursor: pointer;
        position: fixed;
        bottom: 2rem;
        left: 46rem;
      }

      #sendBtn:hover {
        background-color: #45a049;
      }
    </style>
  </head>
  <body>
    <div id="messages"></div>
    <input type="text" id="msg" placeholder="Enter your Question here..." />
    <button id="sendBtn">Send</button>
  </body>
  <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <script>
    const socket = io();
    const sendBtn = document.getElementById("sendBtn");
    const messages = document.getElementById("messages");
    const msg = document.getElementById("msg");

    sendBtn.addEventListener("click", () => {
      const message = msg.value.trim();
      const p = document.createElement("p");
      p.innerText = message;
      p.classList.add("user");
      messages.appendChild(p);
      message.innerText = '';
      messages.scrollTop = messages.scrollHeight;
      socket.emit("userMsg", message);
    });
    socket.on("aiReplay", (aiMsg) => {
      const p = document.createElement("p");
      p.innerHTML = marked.parse(aiMsg);
      p.classList.add("ai");
      messages.appendChild(p);
      message.innerText = '';
      messages.scrollTop = messages.scrollHeight;
    });
  </script>
</html>
