<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <div id="messages"></div>
    <input type="text" id="msg" placeholder="Enter your Question here..." />
    <button id="sendBtn">Send</button>
  </body>
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const sendBtn = document.getElementById("sendBtn");
    const messages = document.getElementById("messages");
    const msg = document.getElementById("msg");
    sendBtn.addEventListener("click", () => {
      const message = msg.value;
      const p = document.createElement('p');
      p.innerText = message;
      messages.appendChild(p);
      socket.emit('userMsg',message);
    });
    socket.on('aiReplay',(aiMsg) => {
      const replayAi = document.createElement('p');
      replayAi.innerText = aiMsg
      messages.appendChild(replayAi);
    })
  </script>
</html>
